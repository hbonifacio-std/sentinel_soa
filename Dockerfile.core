FROM python:3.11-slim

WORKDIR /app

# Variable de entorno para deshabilitar el buffering de salida de Python
ENV PYTHONUNBUFFERED=1

# Instalar dependencias del sistema esenciales para compilaciones
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copiar requerimientos e instalar dependencias de Python
COPY core_orchestrator/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo el código fuente.
COPY core_orchestrator/ ./core_orchestrator/
COPY shared/ ./shared/
COPY data/ ./data/

# El contenedor expone el puerto de la API REST
EXPOSE 8000

# Copiar script de inicialización y hacerlo ejecutable
COPY start_core.sh .
RUN chmod +x start_core.sh

# Comando por defecto para inicializar el Core Orchestrator con MCP integrado
# Se arranca directamente con Python para evitar depender del binario `uvicorn` en PATH.
CMD ["python", "-m", "uvicorn", "core_orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]
