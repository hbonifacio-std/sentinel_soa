# ============================================================================
# CONFIGURACIÓN DE SENTINEL SOA - EJEMPLO CON MÚLTIPLES PROVEEDORES
# ============================================================================
# Este archivo muestra todas las opciones disponibles de configuración.
# Copia este archivo a .env y ajusta según tu proveedor elegido.

# ============================================================================
# 1. SELECCIÓN DEL PROVEEDOR LLM (PRINCIPAL)
# ============================================================================
# Opciones: gemini | ollama | claude | openai
# Default: gemini
LLM_PROVIDER=gemini

# ============================================================================
# 2. CONFIGURACIÓN GEMINI (Google Generative AI)
# ============================================================================
# Requerido solo si LLM_PROVIDER=gemini
# Obtener API Key: https://aistudio.google.com/apikey

# Tu API Key de Google Gemini (OBLIGATORIA si usas Gemini)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo Gemini a utilizar
# Opciones: gemini-1.5-flash (rápido, económico), gemini-1.5-pro (más poderoso)
GEMINI_MODEL=gemini-1.5-flash

# Tokens máximos permitidos en la respuesta
GEMINI_MAX_OUTPUT_TOKENS=1024

# ============================================================================
# 3. CONFIGURACIÓN OLLAMA (Modelos Locales)
# ============================================================================
# Requerido solo si LLM_PROVIDER=ollama
# Documentación: https://ollama.ai

# URL base donde corre Ollama (típicamente en Docker local)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modelo Ollama a utilizar
# Opciones: mistral (recomendado), llama2, neural-chat, dolphin-mixtral, etc.
# Para descargar: docker exec ollama ollama pull mistral
OLLAMA_MODEL=mistral

# Timeout en segundos para requests a Ollama
# Aumentar si usas modelos más grandes o hardware lento
OLLAMA_TIMEOUT_SECONDS=300

# ============================================================================
# 4. CONFIGURACIÓN CLAUDE (Anthropic) - FUTURO
# ============================================================================
# No soportado aún, próximas versiones

# Tu API Key de Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar
# CLAUDE_MODEL=claude-3-sonnet-20240229

# ============================================================================
# 5. CONFIGURACIÓN OPENAI (GPT) - FUTURO
# ============================================================================
# No soportado aún, próximas versiones

# Tu API Key de OpenAI
# OPENAI_API_KEY=sk-...

# Modelo OpenAI a utilizar
# OPENAI_MODEL=gpt-4

# ============================================================================
# EJEMPLOS RÁPIDOS DE USO
# ============================================================================

# EJEMPLO 1: Usar Gemini (DEFAULT - ACTUAL)
# ------------------------------------------
# Descomentar la línea:
# LLM_PROVIDER=gemini
# Asegurarse que GEMINI_API_KEY está configurada
# Comando: python main.py

# EJEMPLO 2: Cambiar a Ollama Local
# -----------------------------------
# 1. Instalar Ollama:
#    docker run -d -p 11434:11434 ollama/ollama
# 2. Descargar modelo:
#    docker exec ollama ollama pull mistral
# 3. Actualizar .env:
#    LLM_PROVIDER=ollama
# 4. Comando:
#    python main.py

# EJEMPLO 3: Usar múltiples proveedores en diferentes máquinas
# ---------------------------------------------------------------
# Máquina 1 (Producción - Gemini):
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=...
#
# Máquina 2 (Desarrollo Local - Ollama):
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=mistral

# ============================================================================
# RECOMENDACIONES
# ============================================================================
# - Para PRODUCCIÓN: Usar Gemini o Claude (cloud, más consistentes)
# - Para DESARROLLO: Usar Ollama local (sin costos, completo control)
# - Para TESTING: Usar Ollama con modelo pequeño (mistral, neural-chat)
# - NO commitear este archivo con API keys reales en Git

# ============================================================================
