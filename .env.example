# ============================================================================
# CONFIGURACIÓN DE SENTINEL SOA - EJEMPLO CON MÚLTIPLES PROVEEDORES
# ============================================================================
# Este archivo muestra todas las opciones disponibles de configuración.
# Copia este archivo a .env y ajusta según tu proveedor elegido.

# ============================================================================
# 1. SELECCIÓN DEL PROVEEDOR LLM (PRINCIPAL)
# ============================================================================
# Opciones: gemini | ollama | claude | openai
# Default: gemini
LLM_PROVIDER=gemini

# ============================================================================
# 2. CONFIGURACIÓN GEMINI (Google Generative AI)
# ============================================================================
# Requerido solo si LLM_PROVIDER=gemini
# Obtener API Key: https://aistudio.google.com/apikey

# Tu API Key de Google Gemini (OBLIGATORIA si usas Gemini)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo Gemini a utilizar
# Opciones: gemini-1.5-flash (rápido, económico), gemini-1.5-pro (más poderoso)
GEMINI_MODEL=gemini-1.5-flash

# Tokens máximos permitidos en la respuesta
GEMINI_MAX_OUTPUT_TOKENS=1024

# ============================================================================
# 3. CONFIGURACIÓN OLLAMA (Modelos Locales)
# ============================================================================
# Requerido solo si LLM_PROVIDER=ollama
# Documentación: https://ollama.ai

# URL base donde corre Ollama (típicamente en Docker local)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modelo Ollama a utilizar
# Opciones: mistral (recomendado), llama2, neural-chat, dolphin-mixtral, etc.
# Para descargar: docker exec ollama ollama pull mistral
OLLAMA_MODEL=mistral

# Timeout en segundos para requests a Ollama
# Aumentar si usas modelos más grandes o hardware lento
OLLAMA_TIMEOUT_SECONDS=300

# ============================================================================
# 4. CONFIGURACIÓN CLAUDE (Anthropic) - FUTURO
# ============================================================================
# No soportado aún, próximas versiones

# Tu API Key de Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar
# CLAUDE_MODEL=claude-3-sonnet-20240229

# ============================================================================
# 5. CONFIGURACIÓN OPENAI (GPT) - FUTURO
# ============================================================================
# No soportado aún, próximas versiones

# Tu API Key de OpenAI
# OPENAI_API_KEY=sk-...

# Modelo OpenAI a utilizar
# OPENAI_MODEL=gpt-4

# ============================================================================
# EJEMPLOS RÁPIDOS DE USO
# ============================================================================

# EJEMPLO 1: Usar Gemini (DEFAULT - ACTUAL)
# ------------------------------------------
# Descomentar la línea:
# LLM_PROVIDER=gemini
# Asegurarse que GEMINI_API_KEY está configurada
# Comando: python main.py

# EJEMPLO 2: Cambiar a Ollama Local
# -----------------------------------
# 1. Instalar Ollama:
#    docker run -d -p 11434:11434 ollama/ollama
# 2. Descargar modelo:
#    docker exec ollama ollama pull mistral
# 3. Actualizar .env:
#    LLM_PROVIDER=ollama
# 4. Comando:
#    python main.py

# EJEMPLO 3: Usar múltiples proveedores en diferentes máquinas
# ---------------------------------------------------------------
# Máquina 1 (Producción - Gemini):
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=...
#
# Máquina 2 (Desarrollo Local - Ollama):
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=mistral

# ============================================================================
# RECOMENDACIONES
# ============================================================================
# - Para PRODUCCIÓN: Usar Gemini o Claude (cloud, más consistentes)
# - Para DESARROLLO: Usar Ollama local (sin costos, completo control)
# - Para TESTING: Usar Ollama con modelo pequeño (mistral, neural-chat)
# - NO commitear este archivo con API keys reales en Git

# ============================================================================

# ============================================================================
# ⚠️  SEGURIDAD CRÍTICA: NUNCA COMMITEAR SECRETOS REALES EN GIT
# ============================================================================
# Este archivo es un TEMPLATE ÚNICAMENTE con valores placeholder
# Copiar a .env local y REEMPLAZAR con valores verdaderos
# Ver .gitignore: .env está PROHIBIDO en git

# ============================================================================
# CORE ORCHESTRATOR SETTINGS
# ============================================================================
# JWT Secret Key - Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<GENERAR_VALOR_SEGURO_token_urlsafe_32>
# Entorno de ejecución (development | staging | production | test)
APP_ENV=development
# Fuente de secretos (env solo permitido para desarrollo)
SECRET_SOURCE=env
# Rotación máxima de secretos (en producción debe ser <= 90)
SECRET_ROTATION_DAYS=30
# Obliga HTTPS para orígenes/URLs sensibles cuando APP_ENV=production
REQUIRE_HTTPS_IN_PRODUCTION=true
HMAC_REPLAY_WINDOW_SECONDS=300
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ENFORCE_TENANT_AUTH=true
API_PORT=8000

# ============================================================================
# INTERNAL MCP SECURITY - Core↔MCP Authentication & Integrity
# ============================================================================
# Shared secret token for authenticated communication between Core Orchestrator and MCP servers.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Backward-compatible fallback (analyst role + signing if no explicit overrides are set):
MCP_INTERNAL_TOKEN=<GENERAR_VALOR_SEGURO_token_hex_32>
#
# Recommended explicit separation:
# - Core->MCP caller token (used in Authorization header by core)
MCP_INTERNAL_CLIENT_TOKEN=<GENERAR_VALOR_SEGURO_token_hex_32>
# - MCP signing token for rules_bundle integrity (can be different from caller token)
MCP_INTERNAL_SIGNING_TOKEN=<GENERAR_VALOR_SEGURO_token_hex_32>
#
# Optional role-scoped tokens for MCP RBAC (CSV supported for zero-downtime rotation):
# MCP_INTERNAL_TOKEN_ADMIN=<GENERAR_VALOR_SEGURO_token_hex_32>
# MCP_INTERNAL_TOKEN_ANALYST=<GENERAR_VALOR_SEGURO_token_hex_32>
# MCP_INTERNAL_TOKEN_VIEWER=<GENERAR_VALOR_SEGURO_token_hex_32>
# MCP_INTERNAL_TOKENS_ANALYST=<TOKEN_ACTUAL>,<TOKEN_NUEVO_EN_ROTACION>
BOOTSTRAP_ON_STARTUP=true
MCP_LOG_ANALYSIS_SERVER_CMD=python mcp_servers/log_analysis_server/server.py

# ============================================================================
# CONFIGURACIÓN DE BASES DE DATOS
# ============================================================================
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=<SET_VIA_DEPLOYMENT_SECRETS>
MONGO_PASSWORD=<SET_VIA_DEPLOYMENT_SECRETS>
MONGO_DB_NAME=sentinel_soa
RULES_MONGO_DB_NAME=heuristic
AUTH_MONGO_DB_NAME=auth
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<SET_VIA_DEPLOYMENT_SECRETS>

# ============================================================================
# RATE LIMITING Y VENTANAS DE TIEMPO
# ============================================================================
WINDOW_THRESHOLD_REQUESTS=50
WINDOW_DURATION_SECONDS=60
MAX_ALERTS_IN_MEMORY=500
DEFAULT_TENANT_RATE=60

# ============================================================================
# CONFIGURACIÓN CORS
# ============================================================================
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# PROVEEDORES LLM (Seleccionar SOLO uno)
# ============================================================================
LLM_PROVIDER=ollama
#LLM_PROVIDER=gemini
#LLM_PROVIDER=openai
#LLM_PROVIDER=groq

# ============================================================================
# OLLAMA (Local - Recomendado para Desarrollo)
# ============================================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=sentinel-analyst
OLLAMA_TIMEOUT_SECONDS=900
DEFAULT_MODEL_ID=sentinel-analyst

# ============================================================================
# GEMINI (Google Generative AI)
# ============================================================================
# Generar en: https://aistudio.google.com/apikey
GEMINI_API_KEY=<SET_VIA_DEPLOYMENT_SECRETS>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4165

# ============================================================================
# OPENAI (GPT)
# ============================================================================
OPENAI_API_KEY=<SET_VIA_DEPLOYMENT_SECRETS>
OPENAI_MODEL=gpt-3.5-turbo-instruct-0914
OPENAI_MAX_OUTPUT_TOKENS=6096
OPENAI_TIMEOUT_SECONDS=60

# ============================================================================
# GROQ
# ============================================================================
GROQ_API_KEY=<SET_VIA_DEPLOYMENT_SECRETS>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60

# ============================================================================
# DEEPSEEK
# ============================================================================
DEEP_SEEK_API_KEY=<SET_VIA_DEPLOYMENT_SECRETS>

# ============================================================================
# CREDENCIALES AUTORIZADAS PARA INGESTA DE TELEMETRÍA
# ============================================================================
# IMPORTANTE: Generar valores ÚNICOS para cada tenant
# Generar CLIENT_ID y API_KEY con: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPECTED_CLIENT_ID=<SET_UNIQUE_CLIENT_ID>
EXPECTED_API_KEY=<GENERAR_VALOR_SEGURO_token_urlsafe_32>
SENTINEL_CLIENT_ID=<SET_UNIQUE_CLIENT_ID>
SENTINEL_API_KEY=<GENERAR_VALOR_SEGURO_token_urlsafe_32>
TELEMETRY_HMAC_PUBLIC_KEY=<SET_UNIQUE_CLIENT_ID>
TELEMETRY_HMAC_SECRET=<GENERAR_VALOR_SEGURO_token_urlsafe_32>
VECTOR_INTERNAL_TOKEN=<GENERAR_VALOR_SEGURO_token_urlsafe_32>
# En producción usar https://... (HTTP plano será rechazado cuando APP_ENV=production)
TELEMETRY_FORWARD_URL=http://core:8000/api/v1/telemetry/ingest/batch

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# LEGACY/DEPRECATED (Mantener solo para compatibilidad backward)
# ============================================================================
# TENANT_BOOTSTRAP: set TENANT_ID and TENANT_API_KEY only when running scripts
# Example:
# TENANT_ID=acme-corp
# TENANT_API_KEY=super-secret-very-long-key
# TENANT_RATE=60
