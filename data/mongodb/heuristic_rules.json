    {
      "rule_id": "sql_injection_patterns_v1",
      "rule_type": "pattern_list",
      "category": "injection",
      "version": 1,
      "created_at": "2026-06-23T10:00:00Z",
      "updated_at": "2026-06-23T10:00:00Z",
      "is_active": true,
      "description": "Patrones de inyección SQL en URIs (básicos, UNION, blind, time-based)",
      "content": {
        "type": "pattern_list",
        "data": {
          "patterns": [
            "' OR '1'='1",
            "' OR 1=1",
            "' OR 'a'='a",
            "admin'--",
            "admin'#",
            "' UNION SELECT",
            "UNION SELECT",
            "%27 OR %271%27=%271",
            "%27 OR 1=1",
            "%27 UNION SELECT",
            "EXEC",
            "EXECUTE",
            "DROP TABLE",
            "INSERT INTO",
            "DELETE FROM",
            "SHUTDOWN",
            "WAITFOR",
            "xp_",
            "1=1--",
            "1=2--",
            "SLEEP(",
            "BENCHMARK(",
            "WAITFOR DELAY"
          ],
          "pattern_kind": "sql_injection",
          "score_per_match": 30
        },
        "match_strategy": "substring_case_insensitive"
      },
      "metadata": {
        "source": "migration_script",
        "changed_by": "system@migration",
        "change_reason": "Migración inicial desde ThreatHeuristics.SQL_INJECTION_PATTERNS",
        "compatibility_version": "1.0.0"
      },
