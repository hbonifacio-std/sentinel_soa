    },
    {
      "rule_id": "path_traversal_patterns_v1",
      "rule_type": "pattern_list",
      "category": "injection",
      "version": 1,
      "created_at": "2026-06-23T10:00:00Z",
      "updated_at": "2026-06-23T10:00:00Z",
      "is_active": true,
      "description": "Patrones de path traversal en URIs (encoding estándar, doble encoding, null byte)",
      "content": {
        "type": "pattern_list",
        "data": {
          "patterns": [
            "../",
            "..%2f",
            "..%5c",
            "..\\/",
            "%2e%2e%2f",
            "%2e%2e%5c",
            "..;/",
            "....//",
            "..%252f",
            "..\\",
            "..\\\\",
            "%c0%ae",
            "%c1%1c",
            "../%00",
            "..%00/"
          ],
          "pattern_kind": "path_traversal",
          "score_per_match": 40
        },
        "match_strategy": "substring_case_insensitive"
      },
