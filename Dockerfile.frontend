# Stage 1: Development image (Vite dev server + HMR)
FROM node:18 AS dev

WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend/package.json ./
# If you have a package-lock.json, copy it too
# COPY package-lock.json ./

# Install dependencies
RUN npm install

# Copy source files for dev mode
COPY frontend/. .

# Expose Vite dev port
EXPOSE 3000

# Run Vite in Docker listening on all interfaces
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

# Stage 2: Build the React application
FROM node:18 AS build

WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend/package.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application files
COPY frontend/. .

# Build the application
RUN npm run build

# Stage 3: Serve the application using Nginx
FROM nginx:stable-alpine

# Copy the build output from the build stage
COPY --from=build /app/build /usr/share/nginx/html

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy the nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
